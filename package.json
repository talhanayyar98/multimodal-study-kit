{
  "name": "multimodal-study-kit",
  "private": true,
  "description": "Browser toolkit for synchronized, privacy-preserving multimodal behavioral data collection in research studies.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "pnpm run build:packages && eslint .",
    "lint:fix": "pnpm run build:packages && eslint . --fix",
    "build:packages": "turbo run build --filter='./packages/*' --output-logs=errors-only",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "clean": "turbo run clean && rm -rf .turbo",
    "roundtrip": "node scripts/roundtrip.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
